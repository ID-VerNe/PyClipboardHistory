# Electron mirrors -- npmmirror.com for Chinese users
electron_mirror=https://npmmirror.com/mirrors/electron/
sharp_binary_host=https://npmmirror.com/mirrors/sharp
sharp_libvips_binary_host=https://npmmirror.com/mirrors/sharp-libvips
better_sqlite3_binary_host=https://npmmirror.com/mirrors/better-sqlite3

# Required for npmmirror.com (non-HTTPS cert)
strict-ssl=false

# WARNING: shamefully-hoist=true flattens dependency hoisting,
# which can cause unexpected module resolution. Keep only if needed.
shamefully-hoist=true
